  {final_delim=end, delim=',', null_field='', quote=double}
(
  RESPONSE_ID:int32 {quote=none};
  PASSENGER_ID:nullable int32 {quote=none};
  PROMO_ID:nullable int32 {quote=none};
  COMMUNICATION_CHANNEL:nullable ustring[max=255];
  SENT_DATE:string[];
  OPENED_FLAG:nullable ustring[max=255];
  CLICKED_FLAG:nullable ustring[max=255];
  BOOKED_FLAG:nullable ustring[max=255];
  RESERVATION_ID:nullable int32;
)
-rejects continue
-reportProgress yes
-firstLineColumnNames
-file  '[&"Airline_Auth.PATH"]\\\\PROMOTION_RESPONSES.csv'

## General options
[ident('Sequential_File_0'); jobmon_ident('Sequential_File_0')]
## Outputs
0> [] 'Sequential_File_0:DSLink10.v'
;

