      TERMINATOR =+=+=+=
//
// Generated file to implement the  transform operator.
//

// define our input/output link names
inputname 0 DSLink3;
outputname 0 DSLink4;

initialize {
	// define our control variables
	int8 RowRejected0;
	int8 NullSetVar0;

	// declare our intermediate variables for this section
	string InterVar0_0;
	string InterVar0_1;

	// initialise constant values which require conversion
	InterVar0_0 = "";
	InterVar0_1 = 0;
	// Stage variable declaration and initialisation
	string StageVar0_vIATA;
	StageVar0_vIATA = InterVar0_0;
	string StageVar0_vName;
	StageVar0_vName = InterVar0_0;
	string StageVar0_vCity;
	StageVar0_vCity = InterVar0_0;
	string StageVar0_vCountry;
	StageVar0_vCountry = InterVar0_0;
	string StageVar0_vTerminal;
	StageVar0_vTerminal = InterVar0_1;
}

mainloop {

	// declare our intermediate variables for this section
	string InterVar0_2;

	// evaluate the stage variables first
	StageVar0_vIATA = u_upper_case(u_trimc_string(DSLink3.IATA_CODE));
	StageVar0_vName = u_upper_case(u_trimc_string(DSLink3.AIRPORT_NAME));
	StageVar0_vCity = u_upper_case(u_trimc_string(DSLink3.CITY));
	StageVar0_vCountry = u_upper_case(u_trimc_string(DSLink3.COUNTRY));
	if (null(DSLink3.TERMINAL_COUNT)) {
		StageVar0_vTerminal = InterVar0_1;
	} else {
		InterVar0_2 = DSLink3.TERMINAL_COUNT;
		StageVar0_vTerminal = InterVar0_2;
	}
	//;

	// initialise the rejected row variable
	RowRejected0 = 1;

	// evaluate columns (no constraints) for link: DSLink4
	DSLink4.AIRPORT_ID = DSLink3.AIRPORT_ID;
	DSLink4.IATA_CODE = StageVar0_vIATA;
	DSLink4.AIRPORT_NAME = StageVar0_vName;
	DSLink4.CITY = StageVar0_vCity;
	DSLink4.COUNTRY = StageVar0_vCountry;
	DSLink4.TERMINAL_COUNT = StageVar0_vTerminal;
	writerecord 0;
	RowRejected0 = 0;
}

finish {
}

