=+=+=+=
   END DSSCRIPT
   BEGIN DSSCRIPT
      Identifier "V5S0_J_LOAD_FACT_OVERNIGHT_STAY_Transformer_1.trx"
      TERMINATOR =+=+=+=
//
// Generated file to implement the V0S1_J_LOAD_FACT_FLIGHT_UPGRADE_Transformer_1 transform operator.
//

// define our input/output link names
inputname 0 DSLink3;
outputname 0 DSLink7;

initialize {
	// define our control variables
	int8 RowRejected0;
	int8 NullSetVar0;

	// declare our intermediate variables for this section
	string InterVar0_0;
	string InterVar0_1;
	string InterVar0_2;
	string InterVar0_3;
	string InterVar0_4;

	// initialise constant values which require conversion
	InterVar0_0 = "/";
	InterVar0_1 = "%mm/%dd/%yyyy";
	InterVar0_2 = "-";
	InterVar0_3 = "%yyyy-%mm-%dd";
	InterVar0_4 = "%dd-%mmm-%yyyy";
	// Stage variable declaration and initialisation
	date StageVar0_vCheckinDate;
	StageVar0_vCheckinDate = date_from_string("2001-01-01");
	date StageVar0_vCheckoutDate;
	StageVar0_vCheckoutDate = date_from_string("2001-01-01");
}

mainloop {

	// declare our intermediate variables for this section
	decimal InterVar0_5;
	decimal InterVar0_6;

	// evaluate the stage variables first
	if ((index_of_substring_basic(DSLink3.CHECK_IN_DATE , InterVar0_0 , 1) > 0)) {
		StageVar0_vCheckinDate = date_from_string(DSLink3.CHECK_IN_DATE , InterVar0_1);
	} else {
		if ((index_of_substring_basic(DSLink3.CHECK_IN_DATE , InterVar0_2 , 1) == 5)) {
			StageVar0_vCheckinDate = date_from_string(DSLink3.CHECK_IN_DATE , InterVar0_3);
		} else {
			StageVar0_vCheckinDate = date_from_string(DSLink3.CHECK_IN_DATE , InterVar0_4);
		}
		//;
	}
	//;
	if ((index_of_substring_basic(DSLink3.CHECK_OUT_DATE , InterVar0_0 , 1) > 0)) {
		StageVar0_vCheckoutDate = date_from_string(DSLink3.CHECK_OUT_DATE , InterVar0_1);
	} else {
		if ((index_of_substring_basic(DSLink3.CHECK_OUT_DATE , InterVar0_2 , 1) == 5)) {
			StageVar0_vCheckoutDate = date_from_string(DSLink3.CHECK_OUT_DATE , InterVar0_3);
		} else {
			StageVar0_vCheckoutDate = date_from_string(DSLink3.CHECK_OUT_DATE , InterVar0_4);
		}
		//;
	}
	//;

	// initialise the rejected row variable
	RowRejected0 = 1;

	// evaluate columns (no constraints) for link: DSLink7
	DSLink7.CHECK_IN_DATE = StageVar0_vCheckinDate;
	DSLink7.CHECK_OUT_DATE = StageVar0_vCheckoutDate;
	DSLink7.ETL_LOAD_DATE = current_date();
	InterVar0_5 = DSLink3.NIGHTS;
	InterVar0_6 = DSLink3.NIGHTLY_RATE_USD;
	DSLink7.TOTAL_STAY_COST_USD = (InterVar0_5 * InterVar0_6);
	writerecord 0;
	RowRejected0 = 0;
}

finish {
}

=+=+=+=
   END DSSCRIPT
   BEGIN DSSCRIPT
      Identifier "V5S0_J_LOAD_FACT_OVERNIGHT_STAY_Transformer_1.trx.osh"
      TERMINATOR =+=+=+=
transform -inputschema record
(
  STAY_ID:int32;
  RESERVATION_ID:int32;
  PASSENGER_ID:int32;
  HOTEL_NAME:ustring[max=255];
  CITY:ustring[max=255];
  COUNTRY:ustring[max=255];
  CHECK_IN_DATE:string[];
  CHECK_OUT_DATE:string[];
  NIGHTS:int32;
  ROOM_TYPE:ustring[max=255];
  NIGHTLY_RATE_USD:int32;
  PAID_BY_AIRLINE:ustring[max=255];
)
-outputschema record
(
  STAY_ID:int32;
  RESERVATION_ID:int32;
  PASSENGER_ID:int32;
  HOTEL_NAME:ustring[max=255];
  CITY:ustring[max=255];
  COUNTRY:ustring[max=255];
  CHECK_IN_DATE:date;
  CHECK_OUT_DATE:date;
  NIGHTS:int32;
