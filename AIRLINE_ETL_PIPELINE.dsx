=+=+=+=
   END DSSCRIPT
   BEGIN DSSCRIPT
      Identifier "V0S17_J_LOAD_FACT_RESERVATION_Transformer_17.trx"
      TERMINATOR =+=+=+=
//
// Generated file to implement the V0S17_J_LOAD_FACT_RESERVATION_Transformer_17 transform operator.
//

// define our input/output link names
inputname 0 DSLink47;
outputname 0 DSLink48;

initialize {
	// define our control variables
	int8 RowRejected0;
	int8 NullSetVar0;

	// Stage variable declaration and initialisation
	string StageVar0_StageVar;
	StageVar0_StageVar = "";
}

mainloop {

	// evaluate the stage variables first

	// initialise the rejected row variable
	RowRejected0 = 1;

	// evaluate columns (no constraints) for link: DSLink48
	DSLink48.RESERVATION_STATUS = DSLink47.STATUS;
	DSLink48.TICKET_ISSUE_DATE = DSLink47.ISSUE_DATE;
	DSLink48.PROFIT_USD = (DSLink47.FINAL_TICKET_AMOUNT_USD - DSLink47.TOTAL_COST_USD);
	DSLink48.ETL_LOAD_DATE = current_date();
	writerecord 0;
	RowRejected0 = 0;
}

finish {
}

=+=+=+=
   END DSSCRIPT
   BEGIN DSSCRIPT
      Identifier "V0S17_J_LOAD_FACT_RESERVATION_Transformer_17.trx.osh"
      TERMINATOR =+=+=+=
transform -inputschema record
(
  RESERVATION_ID:nullable int32;
  PASSENGER_ID:nullable int32;
  FLIGHT_ID:nullable int32;
  FARE_CLASS_ID:nullable int32;
  CHANNEL_ID:nullable int32;
  SEAT_NUMBER:nullable ustring[max=10];
  BOOKING_DATE:nullable timestamp;
  PAYMENT_METHOD:nullable ustring[max=40];
  AMOUNT_PAID:nullable decimal[10,2];
  MILES_EARNED:nullable dfloat;
  MILES_REDEEMED:nullable dfloat;
  PROMO_ID:nullable int32;
  IS_UPGRADE:nullable ustring[max=1];
  STATUS:nullable ustring[max=30];
  TICKET_ID:nullable int32;
  TICKET_NUMBER:nullable ustring[max=30];
  ISSUE_DATE:nullable timestamp;
